# generated by kormake 1.1 for cross-dev; edit kormake.lua and the module.lua files, not this
ninja_required_version = 1.10
cxx = fakecc
ar = fakear
link = 
cxxflags = -std=c++20 -O1
ldflags = -lm

rule cxx_cross
  command = $cxx $cxxflags $defines $includes -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = CXX $out
rule ar_cross
  command = $ar $out $in
  description = AR $out
rule link_cross
  command = $cxx $in -o $out $libs $ldflags
  description = LINK $out
rule cxx_host
  command = $cxx $cxxflags $defines $includes -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = CXX $out
rule ar_host
  command = $ar $out $in
  description = AR $out
rule link_host
  command = $cxx $in -o $out $libs $ldflags
  description = LINK $out
rule copy
  command = '{kormake}' _copy $in $out
  description = COPY $out
pool test_pool
  depth = 1
rule run_test
  command = '{kormake}' _test $in $out '{root}/run-on-device' '--wait'
  pool = test_pool
  description = TEST $in
rule run_test_host
  command = '{kormake}' _test $in $out
  description = TEST $in
rule regen
  command = '{kormake}' -C '{root}' gen cross-dev
  generator = 1
  description = KORMAKE gen cross-dev

rule tool_packer_pack
  command = 'host/bin/packer' $out @$out.rsp
  rspfile = $out.rsp
  rspfile_content = $in
  description = PACK $out
rule tool_compiler_compile_cross_gfx_soft
  command = 'host/bin/compiler' $in --soft -o $out
  description = COMPILE $out

build obj/base/unity.o: cxx_cross {root}/build/cross-dev/gen/base/unity.cc
  includes = -I'{root}/modules/base/include' -I'{root}/build/cross-dev/gen/base' -isystem'{root}/packages/pkg/include'
  defines = -DBASE=1
build lib/libkv_base.a: ar_cross obj/base/unity.o
build host/obj/base/unity.o: cxx_host {root}/build/cross-dev/host/gen/base/unity.cc
  includes = -I'{root}/modules/base/include' -I'{root}/build/cross-dev/host/gen/base' -isystem'{root}/packages/pkg/include'
  defines = -DBASE=1
  cxx = fakecc
  ar = fakear
  link = 
  cxxflags = -std=c++20 -O1
  ldflags = -lm
build host/lib/libkv_base.a: ar_host host/obj/base/unity.o
  cxx = fakecc
  ar = fakear
  link = 
  cxxflags = -std=c++20 -O1
  ldflags = -lm
build host/obj/compiler/unity.o: cxx_host {root}/build/cross-dev/host/gen/compiler/unity.cc
  includes = -I'{root}/modules/base/include' -I'{root}/build/cross-dev/host/gen/compiler'
  defines = 
  cxx = fakecc
  ar = fakear
  link = 
  cxxflags = -std=c++20 -O1
  ldflags = -lm
build host/bin/pkg.dll: copy {root}/packages/pkg/lib/pkg.dll
rule cook
  command = $cmd
  restat = 1
  description = COOK $in
build always-cook: phony
build host/goldberg/compiler.cooked: cook host/goldberg/compiler.roots | always-cook {root}/copy_assets.sh
  cmd = '{kormake}' _cook 'host/goldberg/compiler.cook' 'host/goldberg/compiler.cooked'
build host/bin/compiler: link_host host/obj/compiler/unity.o host/lib/libkv_base.a || host/bin/pkg.dll host/goldberg/compiler.cooked
  libs = -lpkg -L'{root}/packages/pkg/lib'
  cxx = fakecc
  ar = fakear
  link = 
  cxxflags = -std=c++20 -O1
  ldflags = -lm
build bin/shaders/sprite.soft: tool_compiler_compile_cross_gfx_soft {root}/modules/gfx/shaders/sprite.shd | host/bin/compiler
build obj/gfx_soft/soft.o: cxx_cross {root}/modules/gfx-soft/src/soft.cc
  includes = -I'{root}/modules/base/include' -I'{root}/build/cross-dev/gen/gfx_soft'
  defines = 
build lib/libkv_gfx_soft.a: ar_cross obj/gfx_soft/soft.o
build host/obj/packer/unity.o: cxx_host {root}/build/cross-dev/host/gen/packer/unity.cc
  includes = -I'{root}/build/cross-dev/host/gen/packer'
  defines = 
  cxx = fakecc
  ar = fakear
  link = 
  cxxflags = -std=c++20 -O1
  ldflags = -lm
build host/bin/packer: link_host host/obj/packer/unity.o 
  libs = 
  cxx = fakecc
  ar = fakear
  link = 
  cxxflags = -std=c++20 -O1
  ldflags = -lm
build obj/game/unity.o: cxx_cross {root}/build/cross-dev/gen/game/unity.cc
  includes = -I'{root}/modules/base/include' -I'{root}/build/cross-dev/gen/game'
  defines = 
build bin/pkg.dll: copy {root}/packages/pkg/lib/pkg.dll
build goldberg/game.cooked: cook goldberg/game.roots | always-cook {root}/copy_assets.sh
  cmd = '{kormake}' _cook 'goldberg/game.cook' 'goldberg/game.cooked'
build bin/game: link_cross obj/game/unity.o lib/libkv_gfx_soft.a lib/libkv_base.a || bin/shaders/sprite.soft bin/pkg.dll goldberg/game.cooked
  libs = -lpkg -lsys -L'{root}/packages/pkg/lib'
build bin/game.pak: tool_packer_pack goldberg/game.cooked | host/bin/packer
  assets = '{root}/build/assets/game'
build obj/base/tests/base_test.o: cxx_cross {root}/modules/base/tests/base_test.cc
  includes = -I'{root}/modules/base/include' -I'{root}/modules/base/tests' -isystem'{root}/packages/pkg/include'
  defines = -DBASE=1
build bin/base_tests: link_cross obj/base/tests/base_test.o lib/libkv_base.a || bin/pkg.dll
  libs = -lpkg -lsys -L'{root}/packages/pkg/lib'
build goldberg/base_tests.cooked: cook goldberg/base_tests.roots | always-cook {root}/copy_assets.sh
  cmd = '{kormake}' _cook 'goldberg/base_tests.cook' 'goldberg/base_tests.cooked'
build test/base.ok: run_test bin/base_tests | bin/pkg.dll goldberg/base_tests.cooked
build host/obj/compiler/tests/compiler_test.o: cxx_host {root}/modules/compiler/tests/compiler_test.cc
  includes = -I'{root}/modules/base/include' -I'{root}/modules/compiler/tests'
  defines = 
  cxx = fakecc
  ar = fakear
  link = 
  cxxflags = -std=c++20 -O1
  ldflags = -lm
build host/bin/compiler_tests: link_host host/obj/compiler/tests/compiler_test.o host/lib/libkv_base.a || host/bin/pkg.dll
  libs = -lpkg -L'{root}/packages/pkg/lib'
  cxx = fakecc
  ar = fakear
  link = 
  cxxflags = -std=c++20 -O1
  ldflags = -lm
build host/goldberg/compiler_tests.cooked: cook host/goldberg/compiler_tests.roots | always-cook {root}/copy_assets.sh
  cmd = '{kormake}' _cook 'host/goldberg/compiler_tests.cook' 'host/goldberg/compiler_tests.cooked'
build host/test/compiler.ok: run_test_host host/bin/compiler_tests | host/bin/pkg.dll host/goldberg/compiler_tests.cooked host/bin/compiler
build obj/game/tests/game_test.o: cxx_cross {root}/modules/game/tests/game_test.cc
  includes = -I'{root}/modules/base/include' -I'{root}/modules/game/tests'
  defines = 
build bin/game_tests: link_cross obj/game/tests/game_test.o lib/libkv_gfx_soft.a lib/libkv_base.a || bin/shaders/sprite.soft bin/pkg.dll
  libs = -lpkg -lsys -L'{root}/packages/pkg/lib'
build goldberg/game_tests.cooked: cook goldberg/game_tests.roots | always-cook {root}/copy_assets.sh
  cmd = '{kormake}' _cook 'goldberg/game_tests.cook' 'goldberg/game_tests.cooked'
build test/game.ok: run_test bin/game_tests | bin/shaders/sprite.soft bin/pkg.dll goldberg/game_tests.cooked bin/game

build tests: phony bin/base_tests bin/game_tests
build check: phony test/base.ok test/game.ok
build all: phony lib/libkv_base.a host/lib/libkv_base.a host/bin/compiler lib/libkv_gfx_soft.a host/bin/packer bin/game tests
default all

build base: phony lib/libkv_base.a
build compiler: phony host/bin/compiler
build gfx: phony bin/shaders/sprite.soft
build gfx-soft: phony lib/libkv_gfx_soft.a
build packer: phony host/bin/packer
build game: phony bin/game
build build.ninja: regen | {root}/kormake.lua {root}/modules/base/module.lua {root}/modules/compiler/module.lua {root}/modules/extra/module.lua {root}/modules/game/module.lua {root}/modules/gfx/module.lua {root}/modules/gfx-soft/module.lua {root}/modules/packer/module.lua {root}/modules/toolchain-cross/module.lua {root}/modules/toolchain-host/module.lua
