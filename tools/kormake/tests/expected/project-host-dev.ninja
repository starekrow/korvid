# generated by kormake 1.2 for {host}-dev; edit kormake.lua and the module.lua files, not this
ninja_required_version = 1.10
cxx = fakecc
ar = fakear
link = 
cxxflags = -std=c++20 -O1
cc = fakec
cflags = -std=c11 -O1
ldflags = -lm

rule cxx_host
  command = $cxx $cxxflags $defines $includes -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = CXX $out
rule ar_host
  command = $ar $out $in
  description = AR $out
rule link_host
  command = $cxx $in -o $out $libs $ldflags
  description = LINK $out
rule c_host
  command = $cc $cflags $defines $includes -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = C $out
rule copy
  command = '{kormake}' _copy $in $out
  description = COPY $out
rule run_test
  command = '{kormake}' _test $in $out
  description = TEST $in
rule regen
  command = '{kormake}' -C '{project}' gen {host}-dev
  generator = 1
  description = KORMAKE gen {host}-dev

rule tool_packer_pack
  command = 'bin/packer' $out @$out.rsp
  rspfile = $out.rsp
  rspfile_content = $in
  description = PACK $out
rule tool_compiler_compile_{host}_gfx_soft
  command = 'bin/compiler' $in --soft -o $out
  description = COMPILE $out

build obj/codec/unity.o: cxx_host {project}/build/{host}-dev/gen/codec/unity.cc
  includes = -I'{project}/build/{host}-dev/gen/codec' -isystem'/usr/include/sysaudio-1'
  defines = -DKV_BIND_GFX_GFX_SOFT=1 -DKV_BIND_GFX_COUNT=1
  cxxflags = -std=c++20 -O1 -O3
build obj/codec/decode.o: cxx_host {project}/modules/codec/src/decode.cc
  includes = -I'{project}/build/{host}-dev/gen/codec' -isystem'/usr/include/sysaudio-1'
  defines = -DKV_BIND_GFX_GFX_SOFT=1 -DKV_BIND_GFX_COUNT=1
  cxxflags = -std=c++20 -O1 -O3 -fwrapv
build obj/codec/unity_c.o: c_host {project}/build/{host}-dev/gen/codec/unity.c
  includes = -I'{project}/build/{host}-dev/gen/codec' -isystem'/usr/include/sysaudio-1'
  defines = -DKV_BIND_GFX_GFX_SOFT=1 -DKV_BIND_GFX_COUNT=1
  cflags = -std=c11 -O1 -O3
build lib/libkv_codec.a: ar_host obj/codec/unity.o obj/codec/decode.o obj/codec/unity_c.o
build obj/base/unity.o: cxx_host {project}/build/{host}-dev/gen/base/unity.cc
  includes = -I'{root}/modules/base/include' -I'{project}/build/{host}-dev/gen/base' -isystem'{root}/packages/pkg/include'
  defines = -DBASE=1 -DKV_BIND_GFX_GFX_SOFT=1 -DKV_BIND_GFX_COUNT=1
build lib/libkv_base.a: ar_host obj/base/unity.o
build obj/extra/extra.o: cxx_host {project}/modules/extra/src/extra.cc
  includes = -I'{root}/modules/base/include' -I'{project}/build/{host}-dev/gen/extra'
  defines = -DKV_BIND_GFX_GFX_SOFT=1 -DKV_BIND_GFX_COUNT=1
build lib/libkv_extra.a: ar_host obj/extra/extra.o
build obj/player/unity.o: cxx_host {project}/build/{host}-dev/gen/player/unity.cc
  includes = -I'{root}/modules/base/include' -I'{project}/build/{host}-dev/gen/player' -isystem'/usr/include/fakepw-0.3' -isystem'/usr/include/fakespa-0.2' -isystem'{project}/vendor/shared/include'
  defines = -DKV_BIND_GFX_GFX_SOFT=1 -DKV_BIND_GFX_COUNT=1
build bin/pkg.dll: copy {root}/packages/pkg/lib/pkg.dll
rule cook
  command = $cmd
  restat = 1
  description = COOK $in
build always-cook: phony
build goldberg/player.cooked: cook goldberg/player.roots | always-cook {root}/copy_assets.sh
  cmd = '{kormake}' _cook 'goldberg/player.cook' 'goldberg/player.cooked'
build bin/player: link_host obj/player/unity.o lib/libkv_codec.a lib/libkv_base.a || bin/pkg.dll goldberg/player.cooked
  libs = -lsysaudio -lpkg -lfakepw-0.3 -lfakespa -lshared -L'/usr/lib/sysaudio' -L'{root}/packages/pkg/lib' -L'/usr/lib/fakepw' -L'{project}/vendor/shared/lib'
build obj/compiler/unity.o: cxx_host {project}/build/{host}-dev/gen/compiler/unity.cc
  includes = -I'{root}/modules/base/include' -I'{project}/build/{host}-dev/gen/compiler'
  defines = -DKV_BIND_GFX_GFX_SOFT=1 -DKV_BIND_GFX_COUNT=1
build goldberg/compiler.cooked: cook goldberg/compiler.roots | always-cook {root}/copy_assets.sh
  cmd = '{kormake}' _cook 'goldberg/compiler.cook' 'goldberg/compiler.cooked'
build bin/compiler: link_host obj/compiler/unity.o lib/libkv_base.a || bin/pkg.dll goldberg/compiler.cooked
  libs = -lpkg -L'{root}/packages/pkg/lib'
build bin/shaders/sprite.soft: tool_compiler_compile_{host}_gfx_soft {root}/modules/gfx/shaders/sprite.shd | bin/compiler
build obj/gfx_soft/soft.o: cxx_host {root}/modules/gfx-soft/src/soft.cc
  includes = -I'{root}/modules/base/include' -I'{project}/build/{host}-dev/gen/gfx_soft'
  defines = -DKV_BIND_GFX_GFX_SOFT=1 -DKV_BIND_GFX_COUNT=1
build lib/libkv_gfx_soft.a: ar_host obj/gfx_soft/soft.o
build obj/packer/unity.o: cxx_host {project}/build/{host}-dev/gen/packer/unity.cc
  includes = -I'{project}/build/{host}-dev/gen/packer'
  defines = -DKV_BIND_GFX_GFX_SOFT=1 -DKV_BIND_GFX_COUNT=1
build bin/packer: link_host obj/packer/unity.o 
  libs = 
build obj/game/unity.o: cxx_host {project}/build/{host}-dev/gen/game/unity.cc
  includes = -I'{root}/modules/base/include' -I'{project}/build/{host}-dev/gen/game'
  defines = -DKV_BIND_GFX_GFX_SOFT=1 -DKV_BIND_GFX_COUNT=1
build goldberg/game.cooked: cook goldberg/game.roots | always-cook {root}/copy_assets.sh
  cmd = '{kormake}' _cook 'goldberg/game.cook' 'goldberg/game.cooked'
build bin/game: link_host obj/game/unity.o lib/libkv_gfx_soft.a lib/libkv_base.a || bin/shaders/sprite.soft bin/pkg.dll goldberg/game.cooked
  libs = -lpkg -L'{root}/packages/pkg/lib'
build bin/game.pak: tool_packer_pack goldberg/game.cooked | bin/packer
  assets = '{project}/build/assets/game'
build obj/base/tests/base_test.o: cxx_host {root}/modules/base/tests/base_test.cc
  includes = -I'{root}/modules/base/include' -I'{root}/modules/base/tests' -isystem'{root}/packages/pkg/include'
  defines = -DBASE=1 -DKV_BIND_GFX_GFX_SOFT=1 -DKV_BIND_GFX_COUNT=1
build bin/base_tests: link_host obj/base/tests/base_test.o lib/libkv_base.a || bin/pkg.dll
  libs = -lpkg -L'{root}/packages/pkg/lib'
build goldberg/base_tests.cooked: cook goldberg/base_tests.roots | always-cook {root}/copy_assets.sh
  cmd = '{kormake}' _cook 'goldberg/base_tests.cook' 'goldberg/base_tests.cooked'
build test/base.ok: run_test bin/base_tests | bin/pkg.dll goldberg/base_tests.cooked
build obj/compiler/tests/compiler_test.o: cxx_host {root}/modules/compiler/tests/compiler_test.cc
  includes = -I'{root}/modules/base/include' -I'{root}/modules/compiler/tests'
  defines = -DKV_BIND_GFX_GFX_SOFT=1 -DKV_BIND_GFX_COUNT=1
build bin/compiler_tests: link_host obj/compiler/tests/compiler_test.o lib/libkv_base.a || bin/pkg.dll
  libs = -lpkg -L'{root}/packages/pkg/lib'
build goldberg/compiler_tests.cooked: cook goldberg/compiler_tests.roots | always-cook {root}/copy_assets.sh
  cmd = '{kormake}' _cook 'goldberg/compiler_tests.cook' 'goldberg/compiler_tests.cooked'
build test/compiler.ok: run_test bin/compiler_tests | bin/pkg.dll goldberg/compiler_tests.cooked bin/compiler
build obj/game/tests/game_test.o: cxx_host {root}/modules/game/tests/game_test.cc
  includes = -I'{root}/modules/base/include' -I'{root}/modules/game/tests'
  defines = -DKV_BIND_GFX_GFX_SOFT=1 -DKV_BIND_GFX_COUNT=1
build bin/game_tests: link_host obj/game/tests/game_test.o lib/libkv_gfx_soft.a lib/libkv_base.a || bin/shaders/sprite.soft bin/pkg.dll
  libs = -lpkg -L'{root}/packages/pkg/lib'
build goldberg/game_tests.cooked: cook goldberg/game_tests.roots | always-cook {root}/copy_assets.sh
  cmd = '{kormake}' _cook 'goldberg/game_tests.cook' 'goldberg/game_tests.cooked'
build test/game.ok: run_test bin/game_tests | bin/shaders/sprite.soft bin/pkg.dll goldberg/game_tests.cooked bin/game

build tests: phony 
build check: phony 
build all: phony lib/libkv_codec.a lib/libkv_base.a lib/libkv_extra.a bin/player tests
default all

build codec: phony lib/libkv_codec.a
build base: phony lib/libkv_base.a
build extra: phony lib/libkv_extra.a
build player: phony bin/player
build compiler: phony bin/compiler
build gfx: phony bin/shaders/sprite.soft
build gfx-soft: phony lib/libkv_gfx_soft.a
build packer: phony bin/packer
build game: phony bin/game
build build.ninja: regen | {root}/kormake.lua {project}/korvid.config {root}/modules/base/module.lua {root}/modules/compiler/module.lua {root}/modules/game/module.lua {root}/modules/gfx/module.lua {root}/modules/gfx-soft/module.lua {root}/modules/packer/module.lua {root}/modules/toolchain-cross/module.lua {root}/modules/toolchain-host/module.lua {project}/modules/codec/module.lua {project}/modules/extra/module.lua {project}/modules/player/module.lua {project}/pkgs/libfakepw-0.3.pc
