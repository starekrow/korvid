# generated by kormake 1.2 for {host}-ship; edit kormake.lua and the module.lua files, not this
ninja_required_version = 1.10
cxx = fakecc
ar = fakear
link = 
cxxflags = -std=c++20 -O2
cc = fakec
cflags = -std=c11 -O2
ldflags = -lm

rule cxx_host
  command = $cxx $cxxflags $defines $includes -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = CXX $out
rule ar_host
  command = $ar $out $in
  description = AR $out
rule link_host
  command = $cxx $in -o $out $libs $ldflags
  description = LINK $out
rule c_host
  command = $cc $cflags $defines $includes -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = C $out
rule copy
  command = '{kormake}' _copy $in $out
  description = COPY $out
rule run_test
  command = '{kormake}' _test $in $out
  description = TEST $in
rule regen
  command = '{kormake}' -C '{root}' gen {host}-ship
  generator = 1
  description = KORMAKE gen {host}-ship

rule tool_packer_pack
  command = 'host/bin/packer' $out @$out.rsp
  rspfile = $out.rsp
  rspfile_content = $in
  description = PACK $out
rule tool_compiler_compile_{host}_gfx_soft
  command = 'host/bin/compiler' $in --soft -o $out
  description = COMPILE $out

build obj/base/unity.o: cxx_host {root}/build/{host}-ship/gen/base/unity.cc
  includes = -I'{root}/modules/base/include' -I'{root}/build/{host}-ship/gen/base' -isystem'{root}/packages/pkg/include'
  defines = -DBASE=1 -DKV_BIND_GFX_GFX_SOFT=1 -DKV_BIND_GFX_COUNT=1
build lib/libkv_base.a: ar_host obj/base/unity.o
build host/obj/base/unity.o: cxx_host {root}/build/{host}-ship/host/gen/base/unity.cc
  includes = -I'{root}/modules/base/include' -I'{root}/build/{host}-ship/host/gen/base' -isystem'{root}/packages/pkg/include'
  defines = -DBASE=1 -DKV_BIND_GFX_GFX_SOFT=1 -DKV_BIND_GFX_COUNT=1
  cxx = fakecc
  ar = fakear
  link = 
  cxxflags = -std=c++20 -O1
  ldflags = -lm
  cc = fakec
  cflags = -std=c11 -O1
build host/lib/libkv_base.a: ar_host host/obj/base/unity.o
  cxx = fakecc
  ar = fakear
  link = 
  cxxflags = -std=c++20 -O1
  ldflags = -lm
  cc = fakec
  cflags = -std=c11 -O1
build host/obj/compiler/unity.o: cxx_host {root}/build/{host}-ship/host/gen/compiler/unity.cc
  includes = -I'{root}/modules/base/include' -I'{root}/build/{host}-ship/host/gen/compiler'
  defines = -DKV_BIND_GFX_GFX_SOFT=1 -DKV_BIND_GFX_COUNT=1
  cxx = fakecc
  ar = fakear
  link = 
  cxxflags = -std=c++20 -O1
  ldflags = -lm
  cc = fakec
  cflags = -std=c11 -O1
build host/bin/pkg.dll: copy {root}/packages/pkg/lib/pkg.dll
rule cook
  command = $cmd
  restat = 1
  description = COOK $in
build always-cook: phony
build host/goldberg/compiler.cooked: cook host/goldberg/compiler.roots | always-cook {root}/copy_assets.sh
  cmd = '{kormake}' _cook 'host/goldberg/compiler.cook' 'host/goldberg/compiler.cooked'
build host/bin/compiler: link_host host/obj/compiler/unity.o host/lib/libkv_base.a || host/bin/pkg.dll host/goldberg/compiler.cooked
  libs = -lpkg -L'{root}/packages/pkg/lib'
  cxx = fakecc
  ar = fakear
  link = 
  cxxflags = -std=c++20 -O1
  ldflags = -lm
  cc = fakec
  cflags = -std=c11 -O1
build bin/shaders/sprite.soft: tool_compiler_compile_{host}_gfx_soft {root}/modules/gfx/shaders/sprite.shd | host/bin/compiler
build obj/gfx_soft/soft.o: cxx_host {root}/modules/gfx-soft/src/soft.cc
  includes = -I'{root}/modules/base/include' -I'{root}/build/{host}-ship/gen/gfx_soft'
  defines = -DKV_BIND_GFX_GFX_SOFT=1 -DKV_BIND_GFX_COUNT=1
build lib/libkv_gfx_soft.a: ar_host obj/gfx_soft/soft.o
build host/obj/packer/unity.o: cxx_host {root}/build/{host}-ship/host/gen/packer/unity.cc
  includes = -I'{root}/build/{host}-ship/host/gen/packer'
  defines = -DKV_BIND_GFX_GFX_SOFT=1 -DKV_BIND_GFX_COUNT=1
  cxx = fakecc
  ar = fakear
  link = 
  cxxflags = -std=c++20 -O1
  ldflags = -lm
  cc = fakec
  cflags = -std=c11 -O1
build host/bin/packer: link_host host/obj/packer/unity.o 
  libs = 
  cxx = fakecc
  ar = fakear
  link = 
  cxxflags = -std=c++20 -O1
  ldflags = -lm
  cc = fakec
  cflags = -std=c11 -O1
build obj/game/unity.o: cxx_host {root}/build/{host}-ship/gen/game/unity.cc
  includes = -I'{root}/modules/base/include' -I'{root}/build/{host}-ship/gen/game'
  defines = -DKV_BIND_GFX_GFX_SOFT=1 -DKV_BIND_GFX_COUNT=1
build bin/pkg.dll: copy {root}/packages/pkg/lib/pkg.dll
build goldberg/game.cooked: cook goldberg/game.roots | always-cook {root}/copy_assets.sh
  cmd = '{kormake}' _cook 'goldberg/game.cook' 'goldberg/game.cooked'
build bin/game: link_host obj/game/unity.o lib/libkv_gfx_soft.a lib/libkv_base.a || bin/shaders/sprite.soft bin/pkg.dll goldberg/game.cooked
  libs = -lpkg -L'{root}/packages/pkg/lib'
build bin/game.pak: tool_packer_pack goldberg/game.cooked | host/bin/packer
  assets = '{root}/dist/game/assets'
build obj/codec/codec.o: cxx_host {root}/samples/codec/src/codec.cc
  includes = -I'{root}/build/{host}-ship/gen/codec'
  defines = -DKV_BIND_GFX_GFX_SOFT=1 -DKV_BIND_GFX_COUNT=1
build lib/libkv_codec.a: ar_host obj/codec/codec.o
build obj/demo/unity.o: cxx_host {root}/build/{host}-ship/gen/demo/unity.cc
  includes = -I'{root}/modules/base/include' -I'{root}/build/{host}-ship/gen/demo'
  defines = -DKV_BIND_GFX_GFX_SOFT=1 -DKV_BIND_GFX_COUNT=1
build goldberg/demo.cooked: cook goldberg/demo.roots | always-cook {root}/copy_assets.sh
  cmd = '{kormake}' _cook 'goldberg/demo.cook' 'goldberg/demo.cooked'
build bin/demo: link_host obj/demo/unity.o lib/libkv_base.a || bin/pkg.dll goldberg/demo.cooked
  libs = -lpkg -L'{root}/packages/pkg/lib'
build host/obj/stamp/unity.o: cxx_host {root}/build/{host}-ship/host/gen/stamp/unity.cc
  includes = -I'{root}/build/{host}-ship/host/gen/stamp'
  defines = -DKV_BIND_GFX_GFX_SOFT=1 -DKV_BIND_GFX_COUNT=1
  cxx = fakecc
  ar = fakear
  link = 
  cxxflags = -std=c++20 -O1
  ldflags = -lm
  cc = fakec
  cflags = -std=c11 -O1
build host/bin/stamp: link_host host/obj/stamp/unity.o 
  libs = 
  cxx = fakecc
  ar = fakear
  link = 
  cxxflags = -std=c++20 -O1
  ldflags = -lm
  cc = fakec
  cflags = -std=c11 -O1
build obj/base/tests/base_test.o: cxx_host {root}/modules/base/tests/base_test.cc
  includes = -I'{root}/modules/base/include' -I'{root}/modules/base/tests' -isystem'{root}/packages/pkg/include'
  defines = -DBASE=1 -DKV_BIND_GFX_GFX_SOFT=1 -DKV_BIND_GFX_COUNT=1
build bin/base_tests: link_host obj/base/tests/base_test.o lib/libkv_base.a || bin/pkg.dll
  libs = -lpkg -L'{root}/packages/pkg/lib'
build goldberg/base_tests.cooked: cook goldberg/base_tests.roots | always-cook {root}/copy_assets.sh
  cmd = '{kormake}' _cook 'goldberg/base_tests.cook' 'goldberg/base_tests.cooked'
build test/base.ok: run_test bin/base_tests | bin/pkg.dll goldberg/base_tests.cooked
build host/obj/compiler/tests/compiler_test.o: cxx_host {root}/modules/compiler/tests/compiler_test.cc
  includes = -I'{root}/modules/base/include' -I'{root}/modules/compiler/tests'
  defines = -DKV_BIND_GFX_GFX_SOFT=1 -DKV_BIND_GFX_COUNT=1
  cxx = fakecc
  ar = fakear
  link = 
  cxxflags = -std=c++20 -O1
  ldflags = -lm
  cc = fakec
  cflags = -std=c11 -O1
build host/bin/compiler_tests: link_host host/obj/compiler/tests/compiler_test.o host/lib/libkv_base.a || host/bin/pkg.dll
  libs = -lpkg -L'{root}/packages/pkg/lib'
  cxx = fakecc
  ar = fakear
  link = 
  cxxflags = -std=c++20 -O1
  ldflags = -lm
  cc = fakec
  cflags = -std=c11 -O1
build host/goldberg/compiler_tests.cooked: cook host/goldberg/compiler_tests.roots | always-cook {root}/copy_assets.sh
  cmd = '{kormake}' _cook 'host/goldberg/compiler_tests.cook' 'host/goldberg/compiler_tests.cooked'
build host/test/compiler.ok: run_test host/bin/compiler_tests | host/bin/pkg.dll host/goldberg/compiler_tests.cooked host/bin/compiler
build obj/game/tests/game_test.o: cxx_host {root}/modules/game/tests/game_test.cc
  includes = -I'{root}/modules/base/include' -I'{root}/modules/game/tests'
  defines = -DKV_BIND_GFX_GFX_SOFT=1 -DKV_BIND_GFX_COUNT=1
build bin/game_tests: link_host obj/game/tests/game_test.o lib/libkv_gfx_soft.a lib/libkv_base.a || bin/shaders/sprite.soft bin/pkg.dll
  libs = -lpkg -L'{root}/packages/pkg/lib'
build goldberg/game_tests.cooked: cook goldberg/game_tests.roots | always-cook {root}/copy_assets.sh
  cmd = '{kormake}' _cook 'goldberg/game_tests.cook' 'goldberg/game_tests.cooked'
build test/game.ok: run_test bin/game_tests | bin/shaders/sprite.soft bin/pkg.dll goldberg/game_tests.cooked bin/game

build tests: phony bin/base_tests bin/game_tests
build check: phony test/base.ok test/game.ok
build all: phony lib/libkv_base.a host/lib/libkv_base.a host/bin/compiler lib/libkv_gfx_soft.a host/bin/packer bin/game bin/game.pak tests
default all

build base: phony lib/libkv_base.a
build compiler: phony host/bin/compiler
build gfx: phony bin/shaders/sprite.soft
build gfx-soft: phony lib/libkv_gfx_soft.a
build packer: phony host/bin/packer
build game: phony bin/game bin/game.pak
build codec: phony lib/libkv_codec.a
build demo: phony bin/demo
build stamp: phony host/bin/stamp
build build.ninja: regen | {root}/kormake.lua {root}/modules/base/module.lua {root}/modules/compiler/module.lua {root}/modules/extra/module.lua {root}/modules/game/module.lua {root}/modules/gfx/module.lua {root}/modules/gfx-soft/module.lua {root}/modules/packer/module.lua {root}/modules/toolchain-cross/module.lua {root}/modules/toolchain-host/module.lua {root}/samples/codec/module.lua {root}/samples/demo/module.lua {root}/samples/stamp/module.lua
