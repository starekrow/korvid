# generated by kormake 1.1 for {host}-dev; edit kormake.lua and the module.lua files, not this
ninja_required_version = 1.10
cxx = fakecc
ar = fakear
link = 
cxxflags = -std=c++20 -O1
ldflags = -lm

rule cxx_host
  command = $cxx $cxxflags $defines $includes -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = CXX $out
rule ar_host
  command = $ar $out $in
  description = AR $out
rule link_host
  command = $cxx $in -o $out $libs $ldflags
  description = LINK $out
rule copy
  command = '{kormake}' _copy $in $out
  description = COPY $out
rule run_test
  command = '{kormake}' _test $in $out
  description = TEST $in
rule regen
  command = '{kormake}' -C '{root}' gen {host}-dev
  generator = 1
  description = KORMAKE gen {host}-dev

rule tool_packer_pack
  command = 'bin/packer' $out @$out.rsp
  rspfile = $out.rsp
  rspfile_content = $in
  description = PACK $out
rule tool_compiler_compile
  command = 'bin/compiler' $in -o $out
  description = COMPILE $out

build obj/base/unity.o: cxx_host {root}/build/{host}-dev/gen/base/unity.cc
  includes = -I'{root}/modules/base/include' -I'{root}/build/{host}-dev/gen/base' -isystem'{root}/packages/pkg/include'
  defines = -DBASE=1
build bin/assets/base/base.txt: copy {root}/modules/base/assets/base.txt
build bin/assets/base/odd$ name$$.txt: copy {root}/modules/base/assets/odd$ name$$.txt
build bin/assets/base/sub/s.txt: copy {root}/modules/base/assets/sub/s.txt
build lib/libkv_base.a: ar_host obj/base/unity.o
build obj/compiler/unity.o: cxx_host {root}/build/{host}-dev/gen/compiler/unity.cc
  includes = -I'{root}/modules/base/include' -I'{root}/build/{host}-dev/gen/compiler'
  defines = 
build bin/pkg.dll: copy {root}/packages/pkg/lib/pkg.dll
build bin/compiler: link_host obj/compiler/unity.o lib/libkv_base.a || bin/assets/base/base.txt bin/assets/base/odd$ name$$.txt bin/assets/base/sub/s.txt bin/pkg.dll
  libs = -lpkg -L'{root}/packages/pkg/lib'
build bin/shaders/sprite.bin: tool_compiler_compile {root}/modules/gfx/shaders/sprite.shd | bin/compiler
build obj/gfx_soft/soft.o: cxx_host {root}/modules/gfx-soft/src/soft.cc
  includes = -I'{root}/modules/base/include' -I'{root}/build/{host}-dev/gen/gfx_soft'
  defines = 
build lib/libkv_gfx_soft.a: ar_host obj/gfx_soft/soft.o
build obj/packer/unity.o: cxx_host {root}/build/{host}-dev/gen/packer/unity.cc
  includes = -I'{root}/build/{host}-dev/gen/packer'
  defines = 
build bin/packer: link_host obj/packer/unity.o 
  libs = 
build obj/game/unity.o: cxx_host {root}/build/{host}-dev/gen/game/unity.cc
  includes = -I'{root}/modules/base/include' -I'{root}/build/{host}-dev/gen/game'
  defines = 
build bin/assets/game/level.txt: copy {root}/modules/game/assets/level.txt
build bin/game: link_host obj/game/unity.o lib/libkv_gfx_soft.a lib/libkv_base.a || bin/shaders/sprite.bin bin/assets/base/base.txt bin/assets/base/odd$ name$$.txt bin/assets/base/sub/s.txt bin/assets/game/level.txt bin/pkg.dll
  libs = -lpkg -L'{root}/packages/pkg/lib'
build bin/game.pak: tool_packer_pack bin/assets/base/base.txt bin/assets/base/odd$ name$$.txt bin/assets/base/sub/s.txt bin/assets/game/level.txt | bin/packer
build obj/base/tests/base_test.o: cxx_host {root}/modules/base/tests/base_test.cc
  includes = -I'{root}/modules/base/include' -I'{root}/modules/base/tests' -isystem'{root}/packages/pkg/include'
  defines = -DBASE=1
build bin/base_tests: link_host obj/base/tests/base_test.o lib/libkv_base.a || bin/assets/base/base.txt bin/assets/base/odd$ name$$.txt bin/assets/base/sub/s.txt bin/pkg.dll
  libs = -lpkg -L'{root}/packages/pkg/lib'
build test/base.ok: run_test bin/base_tests | bin/assets/base/base.txt bin/assets/base/odd$ name$$.txt bin/assets/base/sub/s.txt bin/pkg.dll
build obj/compiler/tests/compiler_test.o: cxx_host {root}/modules/compiler/tests/compiler_test.cc
  includes = -I'{root}/modules/base/include' -I'{root}/modules/compiler/tests'
  defines = 
build bin/compiler_tests: link_host obj/compiler/tests/compiler_test.o lib/libkv_base.a || bin/assets/base/base.txt bin/assets/base/odd$ name$$.txt bin/assets/base/sub/s.txt bin/pkg.dll
  libs = -lpkg -L'{root}/packages/pkg/lib'
build test/compiler.ok: run_test bin/compiler_tests | bin/assets/base/base.txt bin/assets/base/odd$ name$$.txt bin/assets/base/sub/s.txt bin/pkg.dll
build obj/game/tests/game_test.o: cxx_host {root}/modules/game/tests/game_test.cc
  includes = -I'{root}/modules/base/include' -I'{root}/modules/game/tests'
  defines = 
build bin/game_tests: link_host obj/game/tests/game_test.o lib/libkv_gfx_soft.a lib/libkv_base.a || bin/shaders/sprite.bin bin/assets/base/base.txt bin/assets/base/odd$ name$$.txt bin/assets/base/sub/s.txt bin/assets/game/level.txt bin/pkg.dll
  libs = -lpkg -L'{root}/packages/pkg/lib'
build test/game.ok: run_test bin/game_tests | bin/shaders/sprite.bin bin/assets/base/base.txt bin/assets/base/odd$ name$$.txt bin/assets/base/sub/s.txt bin/assets/game/level.txt bin/pkg.dll

build tests: phony bin/base_tests bin/game_tests
build check: phony test/base.ok test/game.ok
build all: phony lib/libkv_base.a bin/compiler lib/libkv_gfx_soft.a bin/packer bin/game tests
default all

build base: phony lib/libkv_base.a bin/assets/base/base.txt bin/assets/base/odd$ name$$.txt bin/assets/base/sub/s.txt
build compiler: phony bin/compiler
build gfx: phony bin/shaders/sprite.bin
build gfx-soft: phony lib/libkv_gfx_soft.a
build packer: phony bin/packer
build game: phony bin/game
build build.ninja: regen | {root}/kormake.lua {root}/modules/base/module.lua {root}/modules/compiler/module.lua {root}/modules/extra/module.lua {root}/modules/game/module.lua {root}/modules/gfx/module.lua {root}/modules/gfx-soft/module.lua {root}/modules/packer/module.lua {root}/modules/toolchain-cross/module.lua {root}/modules/toolchain-host/module.lua
