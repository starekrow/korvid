#!/bin/sh
# A pkg-config that knows one package, for kormake's tests (KORMAKE_PKG_CONFIG names it).
# FAKE_PKG_MISSING=<package> makes it not know that one either.
[ "$1" = --version ] && { echo 0.0; exit 0; }
pkg=
for a; do pkg=$a; done
[ "$pkg" = libfakepw-0.3 ] && [ "$pkg" != "$FAKE_PKG_MISSING" ] || exit 1
case "$1" in
  --exists) ;;
  --cflags-only-I) echo "-I/usr/include/fakepw-0.3 -I/usr/include/fakespa-0.2";;
  --libs-only-L) echo "-L/usr/lib/fakepw";;
  --libs-only-l) echo "-lfakepw-0.3 -lfakespa";;
  --variable=pcfiledir) cd "$(dirname "$0")" && pwd -P;;
  --modversion) echo 0.3.40;;
  --atleast-version=9*) exit 1;;
  --atleast-version=*) ;;
  *) exit 1;;
esac
