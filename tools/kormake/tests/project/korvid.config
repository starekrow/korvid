-- kormake's test project: a project outside the fixture's engine root that defines
-- externals of its own. tests/run.sh copies it beside the fixture and compares what
-- kormake writes for it with tests/expected/project-*. Nothing here is compiled.
engine "../fixture"
requires_kormake "1.2"
modulepath { "modules" }
-- One that two modules could share, kept in a directory beside this file.
external "shared" {
  linux = { dir = "vendor/shared", include = { "include" }, libdirs = { "lib" }, libs = { "shared" } },
  macos = { dir = "vendor/shared", include = { "include" }, libdirs = { "lib" }, libs = { "shared" } },
  windows = { dir = "vendor/shared", include = { "include" }, libdirs = { "lib" }, libs = { "shared" } },
}
