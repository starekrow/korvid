# Hand-written stand-in for the Ninja file kormake will emit. Mirrors the module
# layout: one object dir and one static library per module, include isolation
# (each module sees only its declared dependencies' include/), tests per module.
# Header-only modules (math, render) have no library, only tests.
ninja_required_version = 1.10

cxx = g++
ar = ar
slangc = slangc
builddir = build

# Configs (kormake.lua): debug = -DKV_DEBUG=1 (which implies KV_DEV), dev = -DKV_DEV=1
# with optimization, ship = neither. Only debug is wired here until kormake exists.
cxxflags = -std=c++20 -g -O0 -DKV_DEBUG=1 -fno-exceptions -fno-rtti $
           -fno-strict-aliasing -Wall -Wextra -Werror
sdl_libs = -lSDL3
zlib_libs = -lz
# The Vulkan loader is reached through SDL_Vulkan_GetVkGetInstanceProcAddr; nothing links it.

inc_core     = -Imodules/core/include
inc_platform = $inc_core -Imodules/platform/include
inc_math     = $inc_core -Imodules/math/include
inc_render   = $inc_math -Imodules/render/include
inc_sprite   = $inc_render -Imodules/sprite/include
inc_rvk      = $inc_render -Imodules/platform/include -Imodules/renderer-vulkan/include
inc_asset    = $inc_render -Imodules/platform/include -Imodules/asset/include
inc_collision = $inc_sprite -Imodules/collision/include
inc_frameloop = $inc_platform -Imodules/math/include -Imodules/render/include $
                -Imodules/sprite/include -Imodules/frameloop/include
inc_example_stones = $inc_platform -Imodules/math/include -Imodules/render/include $
               -Imodules/sprite/include -Imodules/asset/include -Imodules/renderer-vulkan/include $
               -Imodules/frameloop/include -Imodules/example_stones/include
inc_example_rocks = $inc_platform -Imodules/math/include -Imodules/render/include $
               -Imodules/sprite/include -Imodules/collision/include -Imodules/asset/include $
               -Imodules/renderer-vulkan/include -Imodules/frameloop/include -Imodules/example_rocks/include
inc_example_testbed    = $inc_platform -Imodules/math/include -Imodules/render/include $
               -Imodules/sprite/include -Imodules/asset/include -Imodules/renderer-vulkan/include $
               -Imodules/frameloop/include -Imodules/example_testbed/include

rule cxx
  command = $cxx $cxxflags $includes -MMD -MF $out.d -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = CXX $out

rule ar
  command = rm -f $out && $ar crs $out $in
  description = AR $out

rule link
  command = $cxx $in -o $out $libs
  description = LINK $out

rule run_test
  command = ./$in && touch $out
  description = TEST $in

# Module assets land under bin/assets/<module>/; the runtime resolves paths beneath it.
rule copy
  command = cp $in $out
  description = COPY $out

# Slang -> SPIR-V. One module holds every entry point; the pipeline names them.
rule slang
  command = $slangc $in -target spirv -fvk-use-entrypoint-name $
            -depfile $out.d -o $out
  depfile = $out.d
  deps = gcc
  description = SLANG $out

# ---- core ------------------------------------------------------------------
build $builddir/obj/core/memory.o: cxx modules/core/src/memory.cc
  includes = $inc_core
build $builddir/obj/core/log.o: cxx modules/core/src/log.cc
  includes = $inc_core
build $builddir/obj/core/event.o: cxx modules/core/src/event.cc
  includes = $inc_core
build $builddir/obj/core/tick.o: cxx modules/core/src/tick.cc
  includes = $inc_core
build $builddir/obj/core/phase.o: cxx modules/core/src/phase.cc
  includes = $inc_core
build $builddir/obj/core/engine.o: cxx modules/core/src/engine.cc
  includes = $inc_core
build $builddir/obj/core/posix/time.o: cxx modules/core/src/posix/time.cc
  includes = $inc_core
build $builddir/obj/core/posix/os_memory.o: cxx modules/core/src/posix/os_memory.cc
  includes = $inc_core
build $builddir/obj/core/arena.o: cxx modules/core/src/arena.cc
  includes = $inc_core
build $builddir/obj/core/thread.o: cxx modules/core/src/thread.cc
  includes = $inc_core
build $builddir/obj/core/handle.o: cxx modules/core/src/handle.cc
  includes = $inc_core
build $builddir/obj/core/hash.o: cxx modules/core/src/hash.cc
  includes = $inc_core
build $builddir/obj/core/name.o: cxx modules/core/src/name.cc
  includes = $inc_core
build $builddir/obj/core/component.o: cxx modules/core/src/component.cc
  includes = $inc_core
build $builddir/obj/core/kind.o: cxx modules/core/src/kind.cc
  includes = $inc_core
build $builddir/obj/core/timer.o: cxx modules/core/src/timer.cc
  includes = $inc_core

build $builddir/lib/libkv_core.a: ar $builddir/obj/core/memory.o $
    $builddir/obj/core/log.o $builddir/obj/core/event.o $builddir/obj/core/tick.o $
    $builddir/obj/core/phase.o $builddir/obj/core/engine.o $builddir/obj/core/posix/time.o $
    $builddir/obj/core/posix/os_memory.o $builddir/obj/core/arena.o $builddir/obj/core/thread.o $
    $builddir/obj/core/handle.o $builddir/obj/core/hash.o $builddir/obj/core/name.o $
    $builddir/obj/core/component.o $builddir/obj/core/kind.o $builddir/obj/core/timer.o

build $builddir/obj/core/tests/main.o: cxx modules/core/tests/main.cc
  includes = $inc_core
build $builddir/obj/core/tests/handle_test.o: cxx modules/core/tests/handle_test.cc
  includes = $inc_core
build $builddir/obj/core/tests/event_test.o: cxx modules/core/tests/event_test.cc
  includes = $inc_core
build $builddir/obj/core/tests/tick_test.o: cxx modules/core/tests/tick_test.cc
  includes = $inc_core
build $builddir/obj/core/tests/module_test.o: cxx modules/core/tests/module_test.cc
  includes = $inc_core
build $builddir/obj/core/tests/memory_test.o: cxx modules/core/tests/memory_test.cc
  includes = $inc_core
build $builddir/obj/core/tests/map_test.o: cxx modules/core/tests/map_test.cc
  includes = $inc_core
build $builddir/obj/core/tests/name_test.o: cxx modules/core/tests/name_test.cc
  includes = $inc_core
build $builddir/obj/core/tests/random_test.o: cxx modules/core/tests/random_test.cc
  includes = $inc_core
build $builddir/obj/core/tests/component_test.o: cxx modules/core/tests/component_test.cc
  includes = $inc_core
build $builddir/obj/core/tests/kind_test.o: cxx modules/core/tests/kind_test.cc
  includes = $inc_core
build $builddir/obj/core/tests/context_test.o: cxx modules/core/tests/context_test.cc
  includes = $inc_core
build $builddir/obj/core/tests/schedule_test.o: cxx modules/core/tests/schedule_test.cc
  includes = $inc_core
build $builddir/obj/core/tests/handler_test.o: cxx modules/core/tests/handler_test.cc
  includes = $inc_core
build $builddir/obj/core/tests/trigger_test.o: cxx modules/core/tests/trigger_test.cc
  includes = $inc_core

build $builddir/bin/core_tests: link $builddir/obj/core/tests/main.o $
    $builddir/obj/core/tests/handle_test.o $builddir/obj/core/tests/event_test.o $
    $builddir/obj/core/tests/tick_test.o $builddir/obj/core/tests/module_test.o $
    $builddir/obj/core/tests/memory_test.o $builddir/obj/core/tests/map_test.o $
    $builddir/obj/core/tests/name_test.o $builddir/obj/core/tests/random_test.o $
    $builddir/obj/core/tests/component_test.o $builddir/obj/core/tests/kind_test.o $
    $builddir/obj/core/tests/context_test.o $builddir/obj/core/tests/schedule_test.o $
    $builddir/obj/core/tests/handler_test.o $builddir/obj/core/tests/trigger_test.o $builddir/lib/libkv_core.a

# ---- platform --------------------------------------------------------------
build $builddir/obj/platform/module.o: cxx modules/platform/src/module.cc
  includes = $inc_platform
build $builddir/obj/platform/input.o: cxx modules/platform/src/input.cc
  includes = $inc_platform
build $builddir/obj/platform/input_sdl3.o: cxx modules/platform/src/input_sdl3.cc
  includes = $inc_platform
build $builddir/obj/platform/host_window_sdl3.o: cxx modules/platform/src/host_window_sdl3.cc
  includes = $inc_platform
build $builddir/obj/platform/io.o: cxx modules/platform/src/io.cc
  includes = $inc_platform

build $builddir/lib/libkv_platform.a: ar $builddir/obj/platform/module.o $
    $builddir/obj/platform/input.o $builddir/obj/platform/input_sdl3.o $
    $builddir/obj/platform/host_window_sdl3.o $builddir/obj/platform/io.o

build $builddir/obj/platform/tests/main.o: cxx modules/platform/tests/main.cc
  includes = $inc_platform
build $builddir/obj/platform/tests/keymap_test.o: cxx modules/platform/tests/keymap_test.cc
  includes = $inc_platform
build $builddir/obj/platform/tests/io_test.o: cxx modules/platform/tests/io_test.cc
  includes = $inc_platform

build $builddir/bin/platform_tests: link $builddir/obj/platform/tests/main.o $
    $builddir/obj/platform/tests/keymap_test.o $builddir/obj/platform/tests/io_test.o $
    $builddir/lib/libkv_platform.a $builddir/lib/libkv_core.a
  libs = $sdl_libs

# ---- math (header-only) ----------------------------------------------------
build $builddir/obj/math/tests/main.o: cxx modules/math/tests/main.cc
  includes = $inc_math
build $builddir/obj/math/tests/vec2_test.o: cxx modules/math/tests/vec2_test.cc
  includes = $inc_math
build $builddir/obj/math/tests/affine2_test.o: cxx modules/math/tests/affine2_test.cc
  includes = $inc_math

build $builddir/bin/math_tests: link $builddir/obj/math/tests/main.o $
    $builddir/obj/math/tests/vec2_test.o $builddir/obj/math/tests/affine2_test.o $
    $builddir/lib/libkv_core.a

# ---- render (header-only interface; no tests of its own) -------------------

# ---- sprite ----------------------------------------------------------------
build $builddir/obj/sprite/extract.o: cxx modules/sprite/src/extract.cc
  includes = $inc_sprite
build $builddir/obj/sprite/module.o: cxx modules/sprite/src/module.cc
  includes = $inc_sprite

build $builddir/lib/libkv_sprite.a: ar $builddir/obj/sprite/extract.o $builddir/obj/sprite/module.o

build $builddir/obj/sprite/tests/main.o: cxx modules/sprite/tests/main.cc
  includes = $inc_sprite
build $builddir/obj/sprite/tests/world_test.o: cxx modules/sprite/tests/world_test.cc
  includes = $inc_sprite
build $builddir/obj/sprite/tests/extract_test.o: cxx modules/sprite/tests/extract_test.cc
  includes = $inc_sprite

build $builddir/bin/sprite_tests: link $builddir/obj/sprite/tests/main.o $
    $builddir/obj/sprite/tests/world_test.o $builddir/obj/sprite/tests/extract_test.o $
    $builddir/lib/libkv_sprite.a $builddir/lib/libkv_core.a

# ---- collision -------------------------------------------------------------
build $builddir/obj/collision/module.o: cxx modules/collision/src/module.cc
  includes = $inc_collision

build $builddir/lib/libkv_collision.a: ar $builddir/obj/collision/module.o

build $builddir/obj/collision/tests/main.o: cxx modules/collision/tests/main.cc
  includes = $inc_collision
build $builddir/obj/collision/tests/broadphase_test.o: cxx modules/collision/tests/broadphase_test.cc
  includes = $inc_collision

build $builddir/bin/collision_tests: link $builddir/obj/collision/tests/main.o $
    $builddir/obj/collision/tests/broadphase_test.o $builddir/lib/libkv_collision.a $
    $builddir/lib/libkv_sprite.a $builddir/lib/libkv_core.a

# ---- asset -----------------------------------------------------------------
build $builddir/obj/asset/module.o: cxx modules/asset/src/texture.cc
  includes = $inc_asset
build $builddir/obj/asset/png.o: cxx modules/asset/src/png.cc
  includes = $inc_asset

build $builddir/lib/libkv_asset.a: ar $builddir/obj/asset/module.o $builddir/obj/asset/png.o

build $builddir/obj/asset/tests/main.o: cxx modules/asset/tests/main.cc
  includes = $inc_asset
build $builddir/obj/asset/tests/png_test.o: cxx modules/asset/tests/png_test.cc
  includes = $inc_asset -Imodules/asset/tests

build $builddir/bin/asset_tests: link $builddir/obj/asset/tests/main.o $
    $builddir/obj/asset/tests/png_test.o $builddir/lib/libkv_asset.a $builddir/lib/libkv_core.a
  libs = $zlib_libs

# ---- renderer-vulkan -------------------------------------------------------
build $builddir/obj/renderer-vulkan/module.o: cxx modules/renderer-vulkan/src/module.cc
  includes = $inc_rvk
build $builddir/obj/renderer-vulkan/vk_funcs.o: cxx modules/renderer-vulkan/src/vk_funcs.cc
  includes = $inc_rvk
build $builddir/obj/renderer-vulkan/renderer.o: cxx modules/renderer-vulkan/src/renderer.cc
  includes = $inc_rvk

build $builddir/lib/libkv_renderer_vulkan.a: ar $builddir/obj/renderer-vulkan/module.o $
    $builddir/obj/renderer-vulkan/vk_funcs.o $builddir/obj/renderer-vulkan/renderer.o

# Shaders land next to the executables; the renderer finds them via the exe directory.
build $builddir/bin/shaders/sprite.spv: slang modules/renderer-vulkan/shaders/sprite.slang

# ---- frameloop -------------------------------------------------------------
build $builddir/obj/frameloop/frameloop.o: cxx modules/frameloop/src/frameloop.cc
  includes = $inc_frameloop

build $builddir/lib/libkv_frameloop.a: ar $builddir/obj/frameloop/frameloop.o

# ---- example_testbed -----------------------------------------------------------------
build $builddir/obj/example_testbed/main.o: cxx modules/example_testbed/src/main.cc
  includes = $inc_example_testbed
build $builddir/obj/example_testbed/game.o: cxx modules/example_testbed/src/game.cc
  includes = $inc_example_testbed
build $builddir/obj/example_testbed/modules.gen.o: cxx modules/example_testbed/src/modules.gen.cc
  includes = $inc_example_testbed

# example_testbed's assets
build $builddir/bin/assets/example_testbed/ball.png: copy modules/example_testbed/assets/ball.png

build $builddir/bin/example_testbed: link $builddir/obj/example_testbed/main.o $builddir/obj/example_testbed/game.o $
    $builddir/obj/example_testbed/modules.gen.o $builddir/lib/libkv_frameloop.a $
    $builddir/lib/libkv_sprite.a $builddir/lib/libkv_asset.a $builddir/lib/libkv_renderer_vulkan.a $
    $builddir/lib/libkv_platform.a $builddir/lib/libkv_core.a | $builddir/bin/shaders/sprite.spv $
    $builddir/bin/assets/example_testbed/ball.png
  libs = $sdl_libs $zlib_libs

# ---- example_rocks ---------------------------------------------------------
build $builddir/obj/example_rocks/main.o: cxx modules/example_rocks/src/main.cc
  includes = $inc_example_rocks
build $builddir/obj/example_rocks/game.o: cxx modules/example_rocks/src/game.cc
  includes = $inc_example_rocks
build $builddir/obj/example_rocks/modules.gen.o: cxx modules/example_rocks/src/modules.gen.cc
  includes = $inc_example_rocks

build $builddir/bin/assets/example_rocks/ship.png: copy modules/example_rocks/assets/ship.png
build $builddir/bin/assets/example_rocks/rock.png: copy modules/example_rocks/assets/rock.png
build $builddir/bin/assets/example_rocks/dot.png: copy modules/example_rocks/assets/dot.png

build $builddir/bin/example_rocks: link $builddir/obj/example_rocks/main.o $builddir/obj/example_rocks/game.o $
    $builddir/obj/example_rocks/modules.gen.o $builddir/lib/libkv_frameloop.a $builddir/lib/libkv_collision.a $
    $builddir/lib/libkv_sprite.a $builddir/lib/libkv_asset.a $builddir/lib/libkv_renderer_vulkan.a $
    $builddir/lib/libkv_platform.a $builddir/lib/libkv_core.a | $builddir/bin/shaders/sprite.spv $
    $builddir/bin/assets/example_rocks/ship.png $builddir/bin/assets/example_rocks/rock.png $
    $builddir/bin/assets/example_rocks/dot.png
  libs = $sdl_libs $zlib_libs

# ---- example_stones --------------------------------------------------------
build $builddir/obj/example_stones/main.o: cxx modules/example_stones/src/main.cc
  includes = $inc_example_stones
build $builddir/obj/example_stones/game.o: cxx modules/example_stones/src/game.cc
  includes = $inc_example_stones
build $builddir/obj/example_stones/modules.gen.o: cxx modules/example_stones/src/modules.gen.cc
  includes = $inc_example_stones

build $builddir/bin/assets/example_stones/stone.png: copy modules/example_stones/assets/stone.png

build $builddir/bin/example_stones: link $builddir/obj/example_stones/main.o $builddir/obj/example_stones/game.o $
    $builddir/obj/example_stones/modules.gen.o $builddir/lib/libkv_frameloop.a $
    $builddir/lib/libkv_sprite.a $builddir/lib/libkv_asset.a $builddir/lib/libkv_renderer_vulkan.a $
    $builddir/lib/libkv_platform.a $builddir/lib/libkv_core.a | $builddir/bin/shaders/sprite.spv $
    $builddir/bin/assets/example_stones/stone.png
  libs = $sdl_libs $zlib_libs

# ---- aggregates ------------------------------------------------------------
build $builddir/test/core_tests.ok: run_test $builddir/bin/core_tests
build $builddir/test/platform_tests.ok: run_test $builddir/bin/platform_tests
build $builddir/test/math_tests.ok: run_test $builddir/bin/math_tests
build $builddir/test/sprite_tests.ok: run_test $builddir/bin/sprite_tests
build $builddir/test/asset_tests.ok: run_test $builddir/bin/asset_tests
build $builddir/test/collision_tests.ok: run_test $builddir/bin/collision_tests

build tests: phony $builddir/bin/core_tests $builddir/bin/platform_tests $
    $builddir/bin/math_tests $builddir/bin/sprite_tests $builddir/bin/asset_tests $
    $builddir/bin/collision_tests
build all: phony $builddir/bin/example_testbed $builddir/bin/example_rocks $builddir/bin/example_stones tests
build check: phony $builddir/test/core_tests.ok $builddir/test/platform_tests.ok $
    $builddir/test/math_tests.ok $builddir/test/sprite_tests.ok $builddir/test/asset_tests.ok $
    $builddir/test/collision_tests.ok
default all
