<?xml version="1.0"?>
<!-- split: seeds thrown at the ship that slow to a stop and burst into small rings;
     Shoreline's late formations. Active bullets that fire bullets. -->
<bulletml type="vertical">
  <action label="top">
    <repeat><times>2 + $rank * 2</times>
      <action>
        <fire><direction type="aim">0</direction><speed>2.8</speed><bulletRef label="seed"/></fire>
        <wait>40</wait>
      </action>
    </repeat>
  </action>
  <bullet label="seed">
    <action>
      <changeSpeed><speed>0</speed><term>45</term></changeSpeed>
      <wait>50</wait>
      <repeat><times>8 + $rank * 8</times>
        <action><fire><direction type="sequence">360 / (8 + $rank * 8)</direction><speed>1.6</speed><bullet/></fire></action>
      </repeat>
      <vanish/>
    </action>
  </bullet>
</bulletml>
