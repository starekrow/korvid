// The demo's second page (docs/PRDs/Krome-Slice-4-PRD.md, KW15a): every widget krome/std
// has, on a small model (gallery.lua). The header's navigation is the form's; the game
// opens the page a press names.

use "krome/std"
script "kromedemo/gallery.lua"

style nav-item {
    pad=10,4 radius=4 color=muted cursor=hand border=1 border-color=clear
    hover { color=ink }
    selected { bg=item-hover color=ink }
    focused { border-color=ring }
}

def labeled label {
    row gap=12 middle w=fill {
        text "{label}" w=70 color=muted
        slot
    }
}

screen gallery {
    col [page] {
        row pad=16,10 bg=bar middle w=fill gap=16 {
            heading "Krome demo"
            row gap=4 {
                hit [nav-item] id=nav_form -> nav { text "Form" }
                hit [nav-item] selected id=nav_gallery -> nav { text "Widgets" }
            }
            spacer
            text "{last}" color=muted
        }
        menu-bar {
            menu-title "File" id=file {
                menu-item "Open" id=open
                menu-item "Save" id=save_all
                menu-item "Close" id=close_all
            }
            menu-title "View" id=view {
                menu-item "Dark" id=dark
                menu-item "Light" id=light
            }
        }
        row pad=16 gap=16 w=fill h=fill {
            col gap=12 w=300 {
                labeled "Level" {
                    slider id=level @level 0..100 step=5 tooltip="Drag, or the arrows"
                    text "{level}" w=30
                }
                labeled "Done" {
                    progress @done
                    button "+10%" id=more -> more pad=6,2
                }
                labeled "Mode" {
                    radio "Fast" id=fast @mode=fast
                    radio "Careful" id=careful @mode=careful
                }
                labeled "Wrap" {
                    checkbox "Wrap lines" id=wrap @wrap
                }
                labeled "Kind" {
                    dropdown id=kind @kind {
                        option "texture" id=texture
                        option "sound" id=sound
                        option "font" id=font
                        option "shader" id=shader
                    }
                }
                labeled "Name" {
                    input id=name_input @name placeholder="A name"
                }
                labeled "Secret" {
                    password id=secret @secret placeholder="Password"
                }
                // A skin's buttons (Krome slice 7): regions of one sheet (skin.png, 20 x 20
                // cells), a state's look a region beside it, drawn twice their size with
                // their pixels square.
                labeled "Skin" {
                    row gap=8 middle pixel {
                        image "kromedemo/skin.png" id=skin_play region=0,0,20,20 w=40 h=40 -> skin {
                            hover { region=20,0,20,20 }
                            pressed { region=40,0,20,20 }
                        }
                        image "kromedemo/skin.png" id=skin_stop region=0,20,20,20 w=40 h=40 -> skin {
                            hover { region=20,20,20,20 }
                            pressed { region=40,20,20,20 }
                        }
                        image "kromedemo/skin.png" id=skin_small region=0,0,20,20 -> skin {
                            hover { region=20,0,20,20 }
                            pressed { region=40,0,20,20 }
                        }
                    }
                }
                row gap=8 {
                    button "Rename..." id=open_dialog -> open_dialog key="mod+r" tooltip="Ctrl+R"
                    button "Later" id=later -> open_dialog disabled
                }
                text "{renamed}" color=muted
            }
            col gap=8 w=fill h=fill {
                tabs {
                    tab "Tree" id=tab_tree @tab=tree
                    tab "Table" id=tab_table @tab=table
                    tab "Split" id=tab_split @tab=split
                    tab "Icons" id=tab_icons @tab=icons
                    tab "Skin" id=tab_skin @tab=skin
                }
                if tab=tree {
                    tree h=fill {
                        each n in nodes height=22 {
                            hit [tree-row] id="{n.id}" -> toggle dir=row {
                                box w=@n.indent h=1
                                image image=@n.arrow w=20 h=20 color=muted
                                text "{n.name}"
                            }
                        }
                    }
                }
                if tab=table {
                    table h=fill {
                        table-head {
                            column "Name" id=col_name @widths.name
                            column "Size" id=col_size @widths.size
                            column "Kind" id=col_kind @widths.kind
                        }
                        scroll-view h=fill pad=0 {
                            each r in rows height=24 {
                                hit [table-row] dir=row id="{r.id}" -> pick_row context=row_menu {
                                    cell w=@widths.name { text "{r.name}" nowrap }
                                    cell w=@widths.size { text "{r.size}" nowrap }
                                    cell w=@widths.kind { text "{r.kind}" color=muted nowrap }
                                }
                            }
                        }
                    }
                    text "{rows_count} rows; {picked_row}" color=muted
                }
                if tab=icons {
                    // std's icons (krome/icons, Material Symbols): at 16, 20 and 32 pixels,
                    // tinted by the text colour, then the accent. Beside them one at 280,
                    // large enough to be rasterized on a job.
                    row w=fill h=fill gap=12 {
                        scroll-view w=fill h=fill {
                            each i in icons height=36 {
                                row gap=12 middle w=fill {
                                    image image=@i.path w=16 h=16
                                    image image=@i.path w=20 h=20
                                    image image=@i.path w=32 h=32
                                    image image=@i.path w=32 h=32 color=accent
                                    text "{i.name}" color=muted
                                }
                            }
                        }
                        image image="krome/icons/settings.svg" w=280 h=280 color=accent
                    }
                }
                if tab=skin {
                    // A skin's pictures (Krome slice 7), all from skin.png: its 8 x 8 tile
                    // repeated from the page's top left, its 24 x 24 frame stretched between
                    // 8-pixel borders at two sizes, and a button at its own size, centred.
                    box dir=stack w=fill h=fill pixel {
                        image "kromedemo/skin.png" region=60,24,8,8 fit=tile w=fill h=fill
                        col pad=16 gap=16 {
                            image "kromedemo/skin.png" id=frame_small region=60,0,24,24 slice=8 w=200 h=100
                            row gap=16 {
                                image "kromedemo/skin.png" id=frame_large region=60,0,24,24 slice=8 w=400 h=200
                                image "kromedemo/skin.png" region=0,0,20,20 fit=natural w=60 h=200 center middle
                            }
                            // Strips: a knob of 64 frames following the slider, and a spinner
                            // of 12 that Spin plays twice at 10 a second, then rests and says so.
                            row gap=16 middle {
                                image "kromedemo/knob.png" id=knob frames=64 frame-at=@dial w=48 h=48
                                slider id=dial @dial 0..1 step=0.02 w=160
                                image "kromedemo/spinner.png" id=spinner frames=12 across fps=@spin_fps loops=2 w=32 h=32 -> spun
                                button "Spin" id=spin -> spin
                            }
                        }
                    }
                }
                if tab=split {
                    row w=fill h=fill {
                        scroll-view w=@split h=fill {
                            text "The left pane: drag the bar between the panes, or Tab to it and use the arrows." w=fill
                        }
                        splitter id=split @split
                        scroll-view w=fill h=fill {
                            text "The right pane takes the rest." w=fill
                        }
                    }
                }
            }
        }
    }
}

screen dialog {
    dialog "Rename" {
        input id=rename @rename placeholder="A new name"
    }
}

screen row_menu {
    col [context-menu] {
        menu-item "Inspect" id=inspect -> inspect
        menu-item "Copy path" id=copy_path -> copy_path
    }
}
