// Korvid renderer-vulkan: what the sprite shaders share. Layouts mirror renderer_internal.h
// exactly (std430 rows, the push block); binding numbers match vk_resources.cc.
//
// Set 0, the tables: sprite rows, material rows, the sort's scratch and its outputs.
// Set 1, the textures: the sampler and the bindless array (variable count: last binding).
#pragma once

static const uint kBucketCount = 768;  // 256 layers x 3 blend modes
static const uint kLayerMin    = 128;  // added to the clamped layer
static const uint kBlockRows   = 1024; // sprite rows per compute block
static const uint kGroup       = 256;  // threads per workgroup; kBucketCount == 3 * kGroup
static const uint kCulled       = 0xFFFFFFFFu;
static const uint kSpriteAlive  = 1;
static const uint kSpriteScreen = 2; // placed through the screen view, not the camera
static const uint kSortShift    = 2; // sort mode in bits 2-3
static const uint kAnchorShift  = 4; // a screen row's anchor: bits 4-5 x, 6-7 y; 0 center, 1 low, 2 high
static const uint kKeySortMax   = 2048; // rows of one keyed bucket the key sort orders

struct GpuSprite {
    float4 prev;    // position x, y, rotation, scale x, at the start of the stamped tick
    float4 cur;     // the same, now
    float2 scale_y; // prev scale y, cur scale y
    float2 size;    // quad size in world units before the placement's scale
    float4 uv;      // x, y, w, h in texture space
    float4 tint;    // linear RGBA, multiplies the material's tint and the texel
    uint   material;
    uint   stamp;   // the tick of the last Set
    int    layer;
    uint   flags;   // bit 0: alive; bit 1: screen; bits 2-3: sort mode (0 row, 1 key, 2 feet); bits 4-7: anchor
    float  order;   // the key, or the feet's offset below the position
    uint   pad0, pad1, pad2; // scalars: a uint3 would be 16-aligned in std430
};

struct GpuMaterial {
    float4 tint;
    float4 params0; // xy: uv offset
    float4 params1;
    uint   texture; // bindless slot
    uint   blend;   // 0 opaque, 1 alpha, 2 additive
    uint   filter;  // 0 nearest, 1 linear: the sampler
    uint   pad;
};

struct PushData {
    float4 view;         // world to clip: affine2 a, b, c, d
    float2 view_trans;   // tx, ty
    float  alpha;        // interpolation point for rows stamped with `tick`
    uint   tick;
    float4 cull;         // world rows: the view's bounding rect in world units, x, y, w, h
    float4 screen;       // screen pixels (center origin, +y up) to clip
    float2 screen_trans;
    uint   row_count;    // sprite rows the compute passes look at
    uint   key_bucket;   // cs_key_sort: the bucket this dispatch sorts
    float4 screen_cull;  // screen rows: the window rect in pixels
};

[[vk::push_constant]] ConstantBuffer<PushData> gPush;

// Each layer's scroll offset: xy at the previous tick, zw now, by layer + kLayerMin. Every
// world row on the layer is drawn moved by it (screen rows are not), so a plane or a map of
// sprites that never change scrolls for one value a tick.
[[vk::binding(7, 0)]] StructuredBuffer<float4> gLayers;

// The interpolation point of a row: rows set this tick move from prev to cur; the rest
// did not move and sit at cur.
float row_t(GpuSprite s) { return s.stamp == gPush.tick ? gPush.alpha : 1.0; }

// A screen row's anchor as a direction from the window's center: -1, 0 or +1 per axis.
float2 row_anchor(GpuSprite s) {
    uint x = (s.flags >> kAnchorShift) & 3u, y = (s.flags >> (kAnchorShift + 2u)) & 3u;
    return float2(x == 1u ? -1.0 : x == 2u ? 1.0 : 0.0, y == 1u ? -1.0 : y == 2u ? 1.0 : 0.0);
}

// Position, rotation and scale of a row at its interpolation point. A screen row's position
// is measured from its anchor: half the window (screen_cull.zw) toward it from the center.
// Every pass places rows through here, so drawing, culling and sorting agree.
void row_placement(GpuSprite s, out float2 pos, out float rot, out float2 scale) {
    float t = row_t(s);
    pos   = lerp(s.prev.xy, s.cur.xy, t);
    if ((s.flags & kSpriteScreen) != 0) pos += row_anchor(s) * gPush.screen_cull.zw * 0.5;
    else {
        float4 l = gLayers[uint(clamp(s.layer, -128, 127) + int(kLayerMin))];
        pos += lerp(l.xy, l.zw, gPush.alpha);
    }
    rot   = lerp(s.prev.z, s.cur.z, t);
    scale = lerp(float2(s.prev.w, s.scale_y.x), float2(s.cur.w, s.scale_y.y), t);
}

float2 apply_affine(float4 m, float2 t, float2 p) {
    return float2(m.x * p.x + m.z * p.y + t.x,
                  m.y * p.x + m.w * p.y + t.y);
}

// A row's point to clip space, through the view its space says.
float2 row_to_clip(GpuSprite s, float2 p) {
    return (s.flags & kSpriteScreen) != 0 ? apply_affine(gPush.screen, gPush.screen_trans, p)
                                          : apply_affine(gPush.view, gPush.view_trans, p);
}
// The rect a row is culled against.
float4 row_cull(GpuSprite s) { return (s.flags & kSpriteScreen) != 0 ? gPush.screen_cull : gPush.cull; }
