// example_arcfire: value noise for the game's shaders. Cheap and smooth enough for a
// nebula and a burning edge; nothing here needs to match the CPU.
#pragma once

float arc_hash(float2 p) {
    p = frac(p * float2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return frac(p.x * p.y);
}

float arc_noise(float2 p) {
    float2 i = floor(p), f = frac(p);
    float a = arc_hash(i), b = arc_hash(i + float2(1, 0)), c = arc_hash(i + float2(0, 1)), d = arc_hash(i + float2(1, 1));
    float2 u = f * f * (3.0 - 2.0 * f);
    return lerp(lerp(a, b, u.x), lerp(c, d, u.x), u.y);
}

// Four octaves, each turned and shifted so the grid does not show.
float arc_fbm(float2 p) {
    float v = 0.0, amp = 0.5;
    for (int k = 0; k < 4; ++k) {
        v += amp * arc_noise(p);
        p = float2(p.x * 1.6 - p.y * 1.2, p.x * 1.2 + p.y * 1.6) + 17.1;
        amp *= 0.5;
    }
    return v;
}
