<?xml version="1.0"?>
<!-- core_finale: the station's core, the game's last pattern and its densest. A four-armed
     spiral turning steadily, a ring every second turned against it, and an aimed fan every
     two seconds to keep the ship from sitting in the spiral's gaps (the rings and the fans
     are one top action: a runner has two). Rank thickens all three. -->
<bulletml type="vertical">
  <action label="top1">
    <repeat><times>150</times>
      <action>
        <fire><direction type="sequence">7 + $rank * 2</direction><speed>2.1</speed><bullet/></fire>
        <repeat><times>3</times>
          <action><fire><direction type="sequence">90</direction><speed>2.1</speed><bullet/></fire></action>
        </repeat>
        <wait>4</wait>
      </action>
    </repeat>
  </action>
  <action label="top2">
    <repeat><times>5</times>
      <action>
        <wait>60</wait>
        <actionRef label="ring"/>
        <wait>60</wait>
        <actionRef label="ring"/>
        <fire><direction type="aim">-24</direction><speed>3.0</speed><bullet/></fire>
        <repeat><times>8 + $rank * 4</times>
          <action><fire><direction type="sequence">48 / (8 + $rank * 4)</direction><speed>3.0</speed><bullet/></fire></action>
        </repeat>
      </action>
    </repeat>
  </action>
  <action label="ring">
    <fire><direction type="sequence">-11</direction><speed>1.5</speed><bullet/></fire>
    <repeat><times>23 + $rank * 12</times>
      <action><fire><direction type="sequence">360 / (24 + $rank * 12)</direction><speed>1.5</speed><bullet/></fire></action>
    </repeat>
  </action>
</bulletml>
