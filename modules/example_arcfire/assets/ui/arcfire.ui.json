{
  "design": [1280, 720],
  "pixel": false,
  "actions": { "move": "move", "confirm": "confirm", "cancel": "cancel" },
  "style": {
    "font": "example_arcfire/font/PublicPixel.ttf",
    "size": 16,
    "line": 24,
    "space": 16,
    "shadow": "#00000090",
    "colors": {
      "text": "#e8ecff",
      "gold": "#ffd060",
      "dim": "#8890b8",
      "cyan": "#80e0ff",
      "panel": "#0a0c18ff",
      "edge": "#262c58ff",
      "shade": "#00000aa0",
      "deep": "#04050cf0",
      "veil": "#00000a58",
      "black": "#000000ff",
      "warn": "#ff20103a",
      "red": "#ff5040"
    },
    "images": {
      "egg": { "texture": "example_arcfire/made/eggs.png", "rect": [0, 0, 16, 16], "frames": 2, "scale": 1.5 },
      "bomb": { "texture": "example_arcfire/made/bombs.png", "rect": [0, 0, 16, 16], "frames": 2, "scale": 1.5 },
      "cursor": { "texture": "example_arcfire/made/cursor.png", "rect": [0, 0, 32, 32], "scale": 0.75 },
      "vignette": { "texture": "example_arcfire/made/vignette.png", "rect": [0, 0, 135, 180], "scale": 4 }
    },
    "sounds": {
      "move": "example_arcfire/sound/ui_move.ogg",
      "select": "example_arcfire/sound/ui_select.ogg",
      "cancel": "example_arcfire/sound/ui_cancel.ogg",
      "tick": "example_arcfire/sound/ui_move.ogg"
    }
  },
  "screens": {
    "hud": {
      "type": "box", "name": "root", "size": ["fill", "fill"],
      "children": [
        { "type": "image", "name": "vignette", "image": "vignette", "anchor": "center" },
        { "type": "panel", "name": "left", "fill": "panel", "anchor": "center", "pivot": "right", "offset": [-270, 0], "size": [1400, "fill"],
          "children": [
            { "type": "panel", "name": "edge", "fill": "edge", "anchor": "right", "size": [3, "fill"] },
            { "type": "stack", "name": "info", "anchor": "topright", "offset": [-32, 48], "gap": 12, "align": "end",
              "children": [
                { "type": "label", "name": "score_title", "text": "SCORE", "color": "dim" },
                { "type": "label", "name": "score", "text": "{=score}", "color": "gold", "font_scale": 2 },
                { "type": "label", "name": "chain", "text": "CHAIN {=chain} X{=chain_mult}", "color": "gold" },
                { "type": "meter", "name": "chain_bar", "style": "bar", "value": "=chain_left", "max": "=chain_window", "fill": "gold", "size": [120, 6] },
                { "type": "box", "name": "gap1", "size": [8, 16] },
                { "type": "label", "name": "eggs_title", "text": "EGGS", "color": "dim" },
                { "type": "meter", "name": "eggs", "image": "egg", "value": "=eggs", "max": "=eggs_max", "gap": 6 },
                { "type": "box", "name": "gap_bombs", "size": [8, 8] },
                { "type": "label", "name": "bombs_title", "text": "BOMBS", "color": "dim" },
                { "type": "meter", "name": "bombs", "image": "bomb", "value": "=bombs", "max": "=bombs_max", "gap": 6 },
                { "type": "box", "name": "gap_weapon", "size": [8, 8] },
                { "type": "label", "name": "weapon", "text": "{=weapon}", "color": "cyan" },
                { "type": "meter", "name": "power", "style": "bar", "value": "=power", "max": "=power_max", "fill": "cyan", "size": [120, 8] },
                { "type": "label", "name": "options", "text": "OPTIONS {=options}", "color": "dim" },
                { "type": "box", "name": "gap2", "size": [8, 16] },
                { "type": "label", "name": "restarts", "text": "RESTARTS {=restarts}", "color": "dim" },
                { "type": "label", "name": "grazes", "text": "GRAZE {=grazes}", "color": "cyan" } ] } ] },
        { "type": "stack", "name": "boss", "anchor": "top", "offset": [0, 14], "gap": 6, "align": "center", "visible": false,
          "children": [
            { "type": "label", "name": "boss_name", "text": "{=boss_name}", "color": "gold" },
            { "type": "meter", "name": "boss_bar", "style": "bar", "value": "=boss_hp", "max": "=boss_max", "fill": "gold", "size": [440, 10] } ] },
        { "type": "panel", "name": "right", "fill": "panel", "anchor": "center", "pivot": "left", "offset": [270, 0], "size": [1400, "fill"],
          "children": [
            { "type": "panel", "name": "edge", "fill": "edge", "anchor": "left", "size": [3, "fill"] },
            { "type": "stack", "name": "info", "anchor": "topleft", "offset": [32, 48], "gap": 12,
              "children": [
                { "type": "label", "name": "stage", "text": "{=stage}", "color": "gold" },
                { "type": "label", "name": "difficulty", "text": "{=difficulty}", "color": "cyan" },
                { "type": "label", "name": "distance", "text": "{=distance}", "color": "dim" } ] },
            { "type": "stack", "name": "dev", "anchor": "bottomleft", "offset": [32, -40], "gap": 8, "visible": false,
              "children": [
                { "type": "label", "name": "sprites", "text": "SPRITES {=sprites}", "color": "dim" },
                { "type": "label", "name": "bullets", "text": "BULLETS {=bullets}", "color": "dim" },
                { "type": "label", "name": "runners", "text": "RUNNERS {=runners}", "color": "dim" },
                { "type": "label", "name": "deltas", "text": "DELTAS {=deltas}", "color": "dim" },
                { "type": "label", "name": "pairs", "text": "PAIRS {=pairs}", "color": "dim" } ] } ] } ] },
    "title": {
      "type": "box", "name": "title", "size": ["fill", "fill"],
      "children": [
        { "type": "panel", "name": "fill", "fill": "veil", "size": ["fill", "fill"] },
        { "type": "stack", "name": "column", "anchor": "center", "offset": [0, -40], "gap": 28, "align": "center",
          "children": [
            { "type": "label", "name": "logo", "text": "{wave}ARCFIRE{/wave}", "color": "gold", "font_scale": 4 },
            { "type": "label", "name": "tag", "text": "a bullet hell over Shoreline", "color": "dim" },
            { "type": "box", "name": "gap", "size": [8, 24] },
            { "type": "list", "name": "items", "gap": 14, "items": [
              { "type": "label", "name": "arcade", "text": "ARCADE" },
              { "type": "label", "name": "select", "text": "STAGE SELECT" },
              { "type": "label", "name": "scores", "text": "HIGH SCORES" },
              { "type": "label", "name": "options", "text": "OPTIONS" },
              { "type": "label", "name": "quit", "text": "QUIT" } ] },
            { "type": "label", "name": "note", "text": "{=title_note}", "color": "cyan" } ] },
        { "type": "label", "name": "footer", "anchor": "bottom", "offset": [0, -20], "text": "Built with Korvid Engine", "color": "dim" } ] },
    "select": {
      "type": "box", "name": "shade", "size": ["fill", "fill"],
      "children": [
        { "type": "panel", "name": "fill", "fill": "shade", "size": ["fill", "fill"] },
        { "type": "stack", "name": "column", "anchor": "center", "gap": 28, "align": "center",
          "children": [
            { "type": "label", "name": "heading", "text": "STAGE SELECT", "color": "gold", "font_scale": 2 },
            { "type": "list", "name": "items", "gap": 14, "items": [
              { "type": "label", "name": "shoreline", "text": "1  SHORELINE" },
              { "type": "label", "name": "back", "text": "BACK", "event": "back" } ] } ] } ] },
    "difficulty": {
      "type": "box", "name": "shade", "size": ["fill", "fill"],
      "children": [
        { "type": "panel", "name": "fill", "fill": "shade", "size": ["fill", "fill"] },
        { "type": "stack", "name": "column", "anchor": "center", "gap": 28, "align": "center",
          "children": [
            { "type": "label", "name": "heading", "text": "{=select_stage}", "color": "gold", "font_scale": 2 },
            { "type": "list", "name": "items", "gap": 14, "items": [
              { "type": "label", "name": "easy", "text": "EASY" },
              { "type": "label", "name": "normal", "text": "NORMAL" },
              { "type": "label", "name": "hard", "text": "HARD" },
              { "type": "label", "name": "back", "text": "BACK", "event": "back" } ] } ] } ] },
    "pause": {
      "type": "box", "name": "shade", "size": ["fill", "fill"],
      "children": [
        { "type": "panel", "name": "fill", "fill": "shade", "size": ["fill", "fill"] },
        { "type": "stack", "name": "column", "anchor": "center", "gap": 28, "align": "center",
          "children": [
            { "type": "label", "name": "heading", "text": "PAUSED", "color": "gold", "font_scale": 3 },
            { "type": "list", "name": "items", "gap": 14, "items": [
              { "type": "label", "name": "resume", "text": "RESUME" },
              { "type": "label", "name": "options", "text": "OPTIONS" },
              { "type": "label", "name": "quit", "text": "QUIT TO TITLE" } ] } ] } ] },
    "options": {
      "type": "box", "name": "shade", "size": ["fill", "fill"],
      "children": [
        { "type": "panel", "name": "fill", "fill": "shade", "size": ["fill", "fill"] },
        { "type": "stack", "name": "column", "anchor": "center", "gap": 28, "align": "center",
          "children": [
            { "type": "label", "name": "heading", "text": "OPTIONS", "color": "gold", "font_scale": 2 },
            { "type": "list", "name": "items", "gap": 14, "items": [
              { "type": "label", "name": "master", "text": "MASTER" },
              { "type": "label", "name": "music", "text": "MUSIC" },
              { "type": "label", "name": "effects", "text": "EFFECTS" },
              { "type": "label", "name": "start", "text": "ARCADE STARTS" },
              { "type": "label", "name": "dev", "text": "DEV COUNTERS" },
              { "type": "label", "name": "back", "text": "BACK", "event": "back" } ] },
            { "type": "label", "name": "hint", "text": "LEFT AND RIGHT CHANGE", "color": "dim" } ] } ] },
    "gameover": {
      "type": "box", "name": "shade", "size": ["fill", "fill"],
      "children": [
        { "type": "panel", "name": "fill", "fill": "shade", "size": ["fill", "fill"] },
        { "type": "stack", "name": "column", "anchor": "center", "gap": 24, "align": "center",
          "children": [
            { "type": "label", "name": "heading", "text": "{shake}GAME OVER{/shake}", "color": "red", "font_scale": 3 },
            { "type": "label", "name": "score", "text": "{=gameover_score}", "color": "gold" },
            { "type": "label", "name": "count", "text": "CONTINUE?  {=gameover_count}", "color": "cyan", "font_scale": 2 },
            { "type": "list", "name": "items", "gap": 14, "items": [
              { "type": "label", "name": "continue", "text": "CONTINUE" },
              { "type": "label", "name": "end", "text": "END THE RUN" } ] },
            { "type": "label", "name": "hint", "text": "THE STAGE BEGINS AGAIN", "color": "dim" } ] } ] },
    "results": {
      "type": "box", "name": "shade", "size": ["fill", "fill"],
      "children": [
        { "type": "panel", "name": "fill", "fill": "deep", "size": ["fill", "fill"] },
        { "type": "stack", "name": "column", "anchor": "center", "gap": 28, "align": "center",
          "children": [
            { "type": "label", "name": "heading", "text": "RESULTS", "color": "gold", "font_scale": 3 },
            { "type": "label", "name": "lines", "text": "", "reveal": 45, "size": [560, "fit"] },
            { "type": "label", "name": "hint", "text": "CONFIRM TO GO ON", "color": "dim" } ] } ] },
    "name": {
      "type": "box", "name": "shade", "size": ["fill", "fill"],
      "children": [
        { "type": "panel", "name": "fill", "fill": "deep", "size": ["fill", "fill"] },
        { "type": "stack", "name": "column", "anchor": "center", "gap": 24, "align": "center",
          "children": [
            { "type": "label", "name": "heading", "text": "{wave}A HIGH SCORE{/wave}", "color": "gold", "font_scale": 2 },
            { "type": "label", "name": "rank", "text": "{=name_rank}", "color": "cyan" },
            { "type": "panel", "name": "well", "fill": "edge", "size": [200, "fit"], "padding": [10, 8, 10, 8],
              "children": [ { "type": "field", "name": "entry", "anchor": "left", "max_length": 8 } ] },
            { "type": "label", "name": "hint", "text": "YOUR NAME, THEN ENTER", "color": "dim" } ] } ] },
    "scores": {
      "type": "box", "name": "shade", "size": ["fill", "fill"],
      "children": [
        { "type": "panel", "name": "fill", "fill": "deep", "size": ["fill", "fill"] },
        { "type": "stack", "name": "column", "anchor": "center", "gap": 24, "align": "center",
          "children": [
            { "type": "label", "name": "heading", "text": "HIGH SCORES", "color": "gold", "font_scale": 2 },
            { "type": "label", "name": "table", "text": "{=scores_table}", "color": "cyan" },
            { "type": "label", "name": "rows", "text": "", "size": [720, "fit"] },
            { "type": "label", "name": "hint", "text": "CONFIRM TO GO ON", "color": "dim" } ] } ] },
    "attract": {
      "type": "stack", "name": "attract", "anchor": "center", "gap": 14, "align": "center",
      "children": [
        { "type": "label", "name": "press", "text": "PRESS START", "color": "gold", "font_scale": 3 } ] },
    "card": {
      "type": "stack", "name": "card", "anchor": "center", "offset": [0, -160], "gap": 12, "align": "center",
      "children": [
        { "type": "label", "name": "number", "text": "STAGE 1", "color": "dim" },
        { "type": "label", "name": "stage", "text": "{=card_stage}", "color": "gold", "font_scale": 2 },
        { "type": "label", "name": "round", "text": "{=card_round}", "color": "cyan" } ] },
    "confirm": {
      "type": "box", "name": "shade", "size": ["fill", "fill"],
      "children": [
        { "type": "stack", "name": "column", "anchor": "center", "offset": [0, 160], "gap": 20, "align": "center",
          "children": [
            { "type": "label", "name": "question", "text": "{=confirm}", "color": "gold" },
            { "type": "list", "name": "items", "gap": 12, "items": [
              { "type": "label", "name": "no", "text": "NO" },
              { "type": "label", "name": "yes", "text": "YES" } ] } ] } ] },
    "cover": {
      "type": "box", "name": "cover", "size": ["fill", "fill"],
      "children": [
        { "type": "panel", "name": "fill", "fill": "black", "size": ["fill", "fill"] },
        { "type": "stack", "name": "column", "anchor": "center", "gap": 20, "align": "center",
          "children": [
            { "type": "label", "name": "title", "text": "OUT OF EGGS", "color": "gold", "font_scale": 2 },
            { "type": "label", "name": "hint", "text": "The stage begins again", "color": "dim" } ] } ] },
    "clear": {
      "type": "stack", "name": "clear", "anchor": "center", "offset": [0, -80], "gap": 16, "align": "center",
      "children": [
        { "type": "label", "name": "title", "text": "{wave}STAGE CLEAR{/wave}", "color": "gold", "font_scale": 3 },
        { "type": "label", "name": "bonus", "text": "BONUS {=stage_bonus}", "color": "gold" },
        { "type": "label", "name": "next", "text": "{=next_round}", "color": "cyan" } ] },
    "stomp": {
      "type": "panel", "name": "stomp", "fill": "warn", "anchor": "center", "size": [540, "fill"],
      "children": [
        { "type": "label", "name": "warning", "anchor": "center", "offset": [0, 40], "text": "{shake}WARNING{/shake}", "color": "red", "font_scale": 3 } ] }
  }
}
